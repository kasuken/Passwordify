---
import Base from '../layouts/Base.astro';
import ToolIcon from '../components/ToolIcon.astro';

const doList = [
  'Require a reasonable minimum length (8+), allow long passphrases',
  'Screen new passwords against known breach corpora',
  'Accept all printable characters, including spaces and Unicode',
  'Give clear, specific feedback when a password is rejected',
];
const dontList = [
  'Force composition rules (upper + lower + number + symbol)',
  'Expire passwords on a fixed schedule with no cause',
  'Use knowledge-based “security questions”',
  'Truncate or silently strip characters',
];

const faqs = [
  {
    q: 'What is NIST 800-63B?',
    a: 'NIST Special Publication 800-63B is the U.S. standard for digital identity authentication. Its password (“memorized secret”) guidance recommends screening against breached passwords and a minimum length, while dropping forced composition rules and periodic expiry.',
  },
  {
    q: 'How does Passwordify implement it?',
    a: 'The /v1/validate endpoint enforces a configurable minimum length, screens the password against a large breach corpus using k-anonymity, and runs zxcvbn strength analysis — returning a single valid/invalid verdict plus a list of violations.',
  },
  {
    q: 'Can I customise the policy?',
    a: 'Yes. Each request can set minLength, recommendedLength, maxLength and whether to screen breaches, so you can match your own policy while staying aligned with the standard.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="NIST 800-63B Password Validation API | Passwordify"
  description="Implement NIST 800-63B password rules with one API call: breach screening, sensible length checks, and zxcvbn strength — no forced composition or expiry. Self-serve from $1.50/mo."
  schema={pageSchema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="glow-accent"></div>
    <div class="bg-grid absolute inset-0 opacity-70"></div>
    <div class="container-x relative py-16 md:py-24">
      <div class="max-w-3xl">
        <span class="eyebrow"><ToolIcon name="scale" size={15} /> Compliance</span>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl">
          NIST 800-63B password checks, <span class="text-accent">in one API call.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          The modern standard is clear: screen for breaches, allow long passphrases, and drop the
          arbitrary rules. Passwordify’s <span class="chip-mono">/v1/validate</span> turns that
          guidance into a single pass/fail verdict — so your signup flow is compliant by default.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/dashboard" class="btn btn-primary">Get your API key</a>
          <a href="/password-validation-api" class="btn btn-secondary">Validation API overview</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Do / Don't -->
  <section class="section">
    <div class="container-x grid gap-6 md:grid-cols-2">
      <div class="card p-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold"><span class="text-accent"><ToolIcon name="check" size={18} /></span> What the standard asks for</h2>
        <ul class="mt-5 space-y-3">
          {doList.map((d) => (
            <li class="flex items-start gap-2.5 text-sm text-muted"><span class="mt-0.5 text-accent"><ToolIcon name="check" size={16} /></span><span>{d}</span></li>
          ))}
        </ul>
      </div>
      <div class="card p-6">
        <h2 class="text-lg font-semibold">What it drops</h2>
        <ul class="mt-5 space-y-3">
          {dontList.map((d) => (
            <li class="flex items-start gap-2.5 text-sm text-muted"><span class="mt-0.5" aria-hidden="true">✕</span><span>{d}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Code -->
  <section class="section border-t border-line">
    <div class="container-x grid items-start gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">One call</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">A compliant verdict, instantly.</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Send a password to <span class="chip-mono">/v1/validate</span> and get back whether it
          passes, its strength score, breach status, and the exact violations to show the user.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/docs" class="btn btn-primary">Full API reference</a>
          <a href="/pricing" class="btn btn-secondary">See pricing</a>
        </div>
      </div>
      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
          <span class="terminal-title">nist-check.sh</span>
        </div>
        <div class="terminal-body">
<code><span class="tok-fn">curl</span> https://www.passwordify.xyz<span class="tok-str">/api/v1/validate</span> \
  -H <span class="tok-str">"X-API-Key: pk_test_passwordify_demo"</span> \
  -H <span class="tok-str">"Content-Type: application/json"</span> \
  -d <span class="tok-str">'&#123;"password":"correct horse","policy":&#123;"minLength":12&#125;&#125;'</span>

<span class="tok-punc">&#123;</span>
  <span class="tok-prop">"valid"</span><span class="tok-punc">:</span> <span class="tok-key">true</span><span class="tok-punc">,</span>
  <span class="tok-prop">"score"</span><span class="tok-punc">:</span> <span class="tok-num">3</span><span class="tok-punc">,</span>
  <span class="tok-prop">"breached"</span><span class="tok-punc">:</span> <span class="tok-key">false</span><span class="tok-punc">,</span>
  <span class="tok-prop">"violations"</span><span class="tok-punc">:</span> <span class="tok-punc">[]</span>
<span class="tok-punc">&#125;</span></code>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section border-t border-line">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">FAQ</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">NIST 800-63B, answered.</h2>
      </div>
      <div class="mt-10 max-w-3xl divide-y divide-[var(--border)] overflow-hidden rounded-[var(--radius-md)] border border-line">
        {faqs.map((f) => (
          <details class="group bg-surface open:bg-surface-2/50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-ink">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
