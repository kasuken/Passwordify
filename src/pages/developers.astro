---
import Base from '../layouts/Base.astro';
import ApiPlayground from '../components/react/ApiPlayground.tsx';
import ToolIcon from '../components/ToolIcon.astro';

const endpoints = [
  {
    method: 'POST',
    path: '/v1/strength',
    icon: 'gauge',
    desc: 'Score a password 0–4 with zxcvbn. Returns guesses, entropy, crack time and actionable feedback.',
  },
  {
    method: 'POST',
    path: '/v1/breach',
    icon: 'shield',
    desc: 'Check a password against 900M+ breached credentials via k-anonymity — server-side, no corpus to host.',
  },
  {
    method: 'POST',
    path: '/v1/validate',
    icon: 'scale',
    desc: 'One call for a NIST 800-63B verdict: strength + breach + policy, returning a clean list of violations.',
  },
  {
    method: 'POST',
    path: '/v1/generate',
    icon: 'dice',
    desc: 'Generate CSPRNG passwords and passphrases from your backend, with an entropy estimate.',
  },
];

const reasons = [
  ['bolt', 'Ship in an afternoon', 'A single REST endpoint replaces a pile of regex rules and a breach corpus you would otherwise host and update yourself.'],
  ['lock', 'Nothing is logged', 'Passwords sent to the API are processed in memory and never written to disk or logs. Only per-key request counts are kept, for billing.'],
  ['scale', 'Standards, not guesswork', 'Validation follows current NIST 800-63B guidance — screen breaches, drop the arbitrary composition rules and forced expiry.'],
  ['terminal', 'Predictable & documented', 'Consistent JSON, real HTTP status codes, rate-limit headers, and examples in curl, JS, C# and Python.'],
];
---

<Base
  title="Password security API for developers — Passwordify"
  description="Add real password strength scoring, breach screening, NIST 800-63B validation and secure generation to your app with one REST API. Free demo key, clear docs."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="glow-accent"></div>
    <div class="bg-grid absolute inset-0 opacity-70"></div>
    <div class="container-x relative grid items-center gap-14 py-16 md:grid-cols-[1fr_1fr] md:py-24">
      <div>
        <span class="eyebrow"><ToolIcon name="code" size={15} /> For developers</span>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          Password security, <span class="text-accent">as an API.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Add the strength scoring, breach screening and policy checks from these tools
          to your own signup and password-reset flows — one endpoint, no corpus to host,
          nothing logged.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#quickstart" class="btn btn-primary">Quickstart</a>
          <a href="/docs" class="btn btn-secondary">Read the docs</a>
        </div>
        <div class="mt-8 flex items-center gap-3 text-sm text-muted">
          <span>Try it now with the demo key</span>
          <code class="chip-mono">pk_test_passwordify_demo</code>
        </div>
      </div>

      <div class="card relative p-5 shadow-[var(--shadow-lg)] sm:p-6">
        <div class="mb-4 flex items-center justify-between">
          <span class="eyebrow">Live playground</span>
          <span class="pill"><span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--success)"></span> runs locally</span>
        </div>
        <ApiPlayground client:load />
      </div>
    </div>
  </section>

  <!-- Endpoints -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Endpoints</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Four calls. Everything you need.</h2>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          endpoints.map((e) => (
            <div class="card p-6">
              <div class="flex items-center gap-3">
                <span class="inline-grid h-10 w-10 place-items-center rounded-[var(--radius-md)] bg-accent-soft text-accent">
                  <ToolIcon name={e.icon} size={19} />
                </span>
                <div class="flex items-center gap-2">
                  <span class="rounded-[var(--radius-xs)] border border-line bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] font-semibold text-accent">
                    {e.method}
                  </span>
                  <code class="font-mono text-sm text-ink">{e.path}</code>
                </div>
              </div>
              <p class="mt-4 leading-relaxed text-muted">{e.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section border-y border-line bg-surface/40">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Why build on it</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">The boring parts, handled.</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          reasons.map(([icon, title, body]) => (
            <div class="flex items-start gap-4">
              <span class="inline-grid h-11 w-11 flex-shrink-0 place-items-center rounded-[var(--radius-md)] border border-line bg-surface text-accent">
                <ToolIcon name={icon} size={20} />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{title}</h3>
                <p class="mt-1.5 leading-relaxed text-muted">{body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Quickstart -->
  <section id="quickstart" class="section" style="scroll-margin-top: 84px">
    <div class="container-x grid items-start gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Quickstart</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Your first request</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Send any password to <span class="chip-mono">/v1/validate</span> with the demo key and you'll get a
          full verdict back. Swap in a live key when you're ready for production traffic.
        </p>
        <ul class="mt-6 flex flex-col gap-3 text-muted">
          <li class="flex items-start gap-3"><span class="mt-1 text-accent"><ToolIcon name="check" size={16} /></span> Base URL <span class="chip-mono">https://www.passwordify.xyz/api</span></li>
          <li class="flex items-start gap-3"><span class="mt-1 text-accent"><ToolIcon name="check" size={16} /></span> API-key auth via the <span class="chip-mono">X-API-Key</span> header</li>
          <li class="flex items-start gap-3"><span class="mt-1 text-accent"><ToolIcon name="check" size={16} /></span> JSON in, JSON out — always</li>
        </ul>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/docs" class="btn btn-primary">Full API reference</a>
          <a href="/pricing" class="btn btn-secondary">See pricing</a>
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
          <span class="terminal-title">quickstart.sh</span>
        </div>
        <div class="terminal-body">
<code><span class="tok-fn">curl</span> https://www.passwordify.xyz<span class="tok-str">/api/v1/validate</span> \
  -H <span class="tok-str">"X-API-Key: pk_test_passwordify_demo"</span> \
  -H <span class="tok-str">"Content-Type: application/json"</span> \
  -d <span class="tok-str">'&#123;"password":"hunter2"&#125;'</span>

<span class="tok-punc">&#123;</span>
  <span class="tok-prop">"valid"</span><span class="tok-punc">:</span> <span class="tok-key">false</span><span class="tok-punc">,</span>
  <span class="tok-prop">"score"</span><span class="tok-punc">:</span> <span class="tok-num">0</span><span class="tok-punc">,</span>
  <span class="tok-prop">"breached"</span><span class="tok-punc">:</span> <span class="tok-key">true</span><span class="tok-punc">,</span>
  <span class="tok-prop">"breachCount"</span><span class="tok-punc">:</span> <span class="tok-num">64627</span><span class="tok-punc">,</span>
  <span class="tok-prop">"violations"</span><span class="tok-punc">:</span> <span class="tok-punc">[</span><span class="tok-str">"weak"</span><span class="tok-punc">,</span> <span class="tok-str">"found_in_breach"</span><span class="tok-punc">]</span>
<span class="tok-punc">&#125;</span></code>
        </div>
      </div>
    </div>
  </section>

  <!-- Early access CTA -->
  <section class="section pt-0">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-line bg-surface p-10 text-center sm:p-16">
        <div class="glow-accent"></div>
        <div class="relative">
          <span class="eyebrow justify-center">Get started</span>
          <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
            Need a production key?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
            Sign in and create your API key in seconds — no sales call, no waitlist. Start on the
            Free plan and upgrade to Pro from $1.50/mo when you need more volume.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/dashboard" class="btn btn-primary">Get your API key</a>
            <a href="/docs" class="btn btn-secondary">Read the docs</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
