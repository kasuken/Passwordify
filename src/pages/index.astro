---
import Base from '../layouts/Base.astro';
import StrengthAnalyzer from '../components/react/StrengthAnalyzer.tsx';
import ToolIcon from '../components/ToolIcon.astro';

const tools = [
  {
    href: '/tools/password-strength',
    name: 'Strength analyzer',
    desc: 'Real entropy and crack-time estimates from the zxcvbn engine — not a naïve character-count meter.',
    accent: 'var(--s3)',
    icon: 'gauge',
  },
  {
    href: '/tools/breach-check',
    name: 'Breach check',
    desc: 'Match against 900M+ leaked passwords via k-anonymity. Only 5 hash characters ever leave your device.',
    accent: 'var(--danger)',
    icon: 'shield',
  },
  {
    href: '/tools/generator',
    name: 'Secure generator',
    desc: 'Cryptographically strong passwords and diceware passphrases from the Web Crypto CSPRNG.',
    accent: 'var(--accent)',
    icon: 'dice',
  },
];

const endpoints = [
  { method: 'POST', path: '/v1/strength', desc: 'Score a password with zxcvbn' },
  { method: 'POST', path: '/v1/breach', desc: 'k-anonymity breach lookup' },
  { method: 'POST', path: '/v1/validate', desc: 'NIST 800-63B policy check' },
  { method: 'POST', path: '/v1/generate', desc: 'CSPRNG password + passphrase' },
];

const features = [
  {
    title: 'Privacy by construction',
    body: 'The free tools never send a password anywhere. Breach checks use k-anonymity — a 5-character hash prefix, padded so response size leaks nothing.',
  },
  {
    title: 'NIST 800-63B aligned',
    body: 'Validation follows current guidance: check length, screen against breach corpora, and drop the outdated rules — no forced composition, no periodic expiry.',
  },
  {
    title: 'Real strength estimation',
    body: 'Powered by zxcvbn — pattern, dictionary and keyboard-walk aware. It catches “P@ssw0rd!” that a regex meter happily calls strong.',
  },
  {
    title: 'One integration, four checks',
    body: 'A single REST API for strength, breach, policy and generation. Ship the exact experience from these tools inside your own signup flow.',
  },
];
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="glow-accent"></div>
    <div class="bg-grid absolute inset-0 opacity-70"></div>
    <div class="container-x relative grid items-center gap-14 py-16 md:grid-cols-[1.05fr_0.95fr] md:py-24">
      <div>
        <span class="eyebrow">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
          Password security, done right
        </span>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          Make every password <span class="text-accent">actually strong.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Free, in-browser tools to measure strength, catch breached passwords, and
          generate strong ones — and a developer API to put the same checks inside
          your app. Passwords never touch our servers.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#tools" class="btn btn-primary">Try the free tools</a>
          <a href="/developers" class="btn btn-secondary">
            Explore the API
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> 100% client-side tools</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> k-anonymity breach lookup</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Open source</li>
        </ul>
      </div>

      <!-- Live analyzer: the hero is a working demo -->
      <div class="card relative p-5 shadow-[var(--shadow-lg)] sm:p-6">
        <div class="mb-4 flex items-center justify-between">
          <span class="eyebrow">Live analyzer</span>
          <span class="pill">
            <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--success)"></span>
            offline
          </span>
        </div>
        <StrengthAnalyzer client:idle initial="Summer2024!" />
      </div>
    </div>
  </section>

  <!-- ================= TOOLS ================= -->
  <section id="tools" class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Free tools</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Three tools. Zero data collected.
        </h2>
        <p class="mt-4 text-lg text-muted">
          Everything below runs in your browser. No account, no logging, no password
          ever leaving the page.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          tools.map((t) => (
            <a
              href={t.href}
              class="card group relative flex flex-col p-6 transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-[var(--shadow-md)]"
            >
              <span
                class="inline-grid h-11 w-11 place-items-center rounded-[var(--radius-md)]"
                style={`background: color-mix(in srgb, ${t.accent} 14%, transparent); color: ${t.accent}`}
              >
                <ToolIcon name={t.icon} size={22} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{t.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{t.desc}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                Open tool
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= API ================= -->
  <section class="section border-y border-line bg-surface/40">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div>
        <span class="eyebrow">For developers</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          The same checks, one API call away.
        </h2>
        <p class="mt-4 text-lg text-muted">
          Stop shipping regex password rules. Add real strength scoring, breach
          screening, and NIST-aligned policy validation to your signup and reset
          flows with a single REST endpoint.
        </p>

        <ul class="mt-8 flex flex-col divide-y divide-[var(--border)] overflow-hidden rounded-[var(--radius-md)] border border-line">
          {
            endpoints.map((e) => (
              <li class="flex items-center gap-3 bg-surface px-4 py-3">
                <span class="rounded-[var(--radius-xs)] border border-line bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] font-semibold text-accent">
                  {e.method}
                </span>
                <code class="font-mono text-sm text-ink">{e.path}</code>
                <span class="ml-auto hidden text-sm text-muted sm:block">{e.desc}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/developers" class="btn btn-primary">Get an API key</a>
          <a href="/docs" class="btn btn-secondary">Read the docs</a>
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">validate.sh</span>
        </div>
        <div class="terminal-body">
<code><span class="tok-com"># Screen a password at signup — strength + breach + policy</span>
<span class="tok-fn">curl</span> https://passwordify.xyz<span class="tok-str">/api/v1/validate</span> \
  -H <span class="tok-str">"Authorization: Bearer pk_live_â€¦"</span> \
  -H <span class="tok-str">"Content-Type: application/json"</span> \
  -d <span class="tok-str">'&#123;"password":"Summer2024!"&#125;'</span>

<span class="tok-com"># â†’ 200 OK</span>
<span class="tok-punc">&#123;</span>
  <span class="tok-prop">"valid"</span><span class="tok-punc">:</span> <span class="tok-key">false</span><span class="tok-punc">,</span>
  <span class="tok-prop">"score"</span><span class="tok-punc">:</span> <span class="tok-num">2</span><span class="tok-punc">,</span>
  <span class="tok-prop">"breached"</span><span class="tok-punc">:</span> <span class="tok-key">true</span><span class="tok-punc">,</span>
  <span class="tok-prop">"breachCount"</span><span class="tok-punc">:</span> <span class="tok-num">3529</span><span class="tok-punc">,</span>
  <span class="tok-prop">"violations"</span><span class="tok-punc">:</span> <span class="tok-punc">[</span><span class="tok-str">"found_in_breach"</span><span class="tok-punc">]</span>
<span class="tok-punc">&#125;</span></code>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURES ================= -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Why Passwordify</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Built on the modern security consensus.
        </h2>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-[var(--border)] sm:grid-cols-2">
        {
          features.map((f) => (
            <div class="bg-surface p-7">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="section pt-0">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-line bg-surface p-10 text-center sm:p-16">
        <div class="glow-accent"></div>
        <div class="relative">
          <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
            Give your users passwords worth trusting.
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
            Start free with the browser tools, then wire up the API when you're ready
            to protect real accounts.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/developers" class="btn btn-primary">Get your API key</a>
            <a href="/pricing" class="btn btn-secondary">See pricing</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  code {
    color: inherit;
  }
</style>
