---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Passwordify" description="The page you're looking for doesn't exist.">
  <section class="section">
    <div class="container-x">
      <div class="mx-auto flex max-w-md flex-col items-center py-16 text-center">
        <span class="font-mono text-6xl font-semibold text-accent">404</span>
        <h1 class="mt-5 text-3xl font-semibold tracking-tight">This page slipped away.</h1>
        <p class="mt-4 text-muted">
          The link may be broken or the page may have moved. Let's get you back to
          something useful.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-primary">Back home</a>
          <a href="/tools/password-strength" class="btn btn-secondary">Try the tools</a>
        </div>
      </div>
    </div>
  </section>
</Base>
