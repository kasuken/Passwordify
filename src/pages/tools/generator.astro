---
import Base from '../../layouts/Base.astro';
import Generator from '../../components/react/Generator.tsx';
import ToolIcon from '../../components/ToolIcon.astro';
---

<Base
  title="Secure password generator — Passwordify"
  description="Generate cryptographically secure passwords and memorable diceware passphrases in your browser, powered by the Web Crypto CSPRNG. Live entropy readout, no data collected."
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid absolute inset-0 opacity-60"></div>
    <div class="container-x relative py-14 md:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">
          <ToolIcon name="dice" size={15} /> Secure generator
        </span>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
          Generate a password worth using.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Cryptographically secure passwords and memorable passphrases, generated in your
          browser with the Web Crypto CSPRNG — with a live entropy readout.
        </p>
      </div>

      <div class="card mx-auto mt-10 max-w-2xl p-6 shadow-[var(--shadow-lg)] sm:p-8">
        <Generator client:load />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow"><ToolIcon name="key" size={14} /> Password vs passphrase</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Two good options.</h2>
        <p class="mt-4 leading-relaxed text-muted">
          A random <strong class="text-ink">password</strong> packs maximum entropy into the
          fewest characters — perfect when a password manager remembers it for you.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          A <strong class="text-ink">passphrase</strong> strings together random words from
          the 7,776-word EFF list. Each word adds
          <span class="chip-mono">12.9 bits</span> of entropy, so five words already means
          a ~64-bit secret you can actually type and remember.
        </p>
      </div>
      <div class="grid content-start gap-3">
        {
          [
            ['fingerprint', 'True randomness', 'Every character is drawn from crypto.getRandomValues with rejection sampling — no modulo bias, no predictable seed.'],
            ['bolt', 'Live entropy', 'The bit count updates as you adjust length and options, so you can see exactly how strong the result is.'],
            ['lock', 'Never transmitted', 'Generation happens on your device. Nothing is sent, stored, or logged.'],
          ].map(([icon, title, body]) => (
            <div class="card flex items-start gap-4 p-5">
              <span class="mt-0.5 inline-grid h-10 w-10 flex-shrink-0 place-items-center rounded-[var(--radius-md)] bg-accent-soft text-accent">
                <ToolIcon name={icon} size={19} />
              </span>
              <div>
                <h3 class="font-semibold">{title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">{body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-x">
      <div class="card flex flex-col items-center gap-5 p-10 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Generate passwords from your backend</h2>
          <p class="mt-2 text-muted">The <span class="chip-mono">/v1/generate</span> endpoint returns CSPRNG passwords over HTTPS.</p>
        </div>
        <div class="flex flex-shrink-0 gap-3">
          <a href="/developers" class="btn btn-primary">Explore the API</a>
          <a href="/docs" class="btn btn-secondary">Docs</a>
        </div>
      </div>
    </div>
  </section>
</Base>
