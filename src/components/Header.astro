---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/tools/password-strength', label: 'Strength' },
  { href: '/tools/breach-check', label: 'Breach check' },
  { href: '/tools/generator', label: 'Generator' },
  { href: '/developers', label: 'API' },
  { href: '/docs', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-bg/80 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="Passwordify home">
      <Logo size={26} />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((l) => {
          const active = path === l.href;
          return (
            <a
              href={l.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                active ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {l.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/kasuken/Passwordify"
        target="_blank"
        rel="noopener"
        class="btn-ghost hidden h-9 w-9 place-items-center rounded-[var(--radius-sm)] border border-line text-muted hover:text-ink sm:inline-grid"
        aria-label="Passwordify on GitHub"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A12 12 0 0 0 8.2 23.9c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7 0-.7 0-.7 1.2 0 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a href="/developers" class="btn btn-primary hidden sm:inline-flex">Get API key</a>
      <button
        id="menu-btn"
        type="button"
        class="btn-ghost inline-grid h-9 w-9 place-items-center rounded-[var(--radius-sm)] border border-line text-muted md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="container-x hidden flex-col gap-1 border-t border-line pb-4 pt-2 md:!hidden"
    aria-label="Mobile"
  >
    {
      links.map((l) => (
        <a href={l.href} class="rounded-md px-3 py-2.5 text-[15px] font-medium text-muted hover:bg-surface-2 hover:text-ink">
          {l.label}
        </a>
      ))
    }
    <a href="/developers" class="btn btn-primary mt-2">Get API key</a>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>
