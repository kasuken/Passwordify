---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path only, e.g. "/pricing"; canonical is derived from Astro.site. */
  ogImage?: string;
  /** Optional page-specific JSON-LD structured data (object or array). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep the page out of search indexes (transactional/dead-end pages). */
  noindex?: boolean;
}

const {
  title = 'Passwordify — Password Security API & Free Privacy-First Tools',
  description = 'Free, private password strength, breach and generator tools that run in your browser — plus a developer API for zxcvbn strength scoring, k-anonymity breach checks and NIST 800-63B validation. A simple, self-serve alternative to enterprise-priced breach APIs.',
  ogImage = '/og.png',
  schema,
  noindex = false,
} = Astro.props;

const siteBase = Astro.site ?? 'https://www.passwordify.xyz';
const canonical = new URL(Astro.url.pathname, siteBase).href;
const ogUrl = new URL(ogImage, siteBase).href;

// Sitewide structured data — helps search engines understand the brand (E-E-A-T)
// and can enable a sitelinks search box / knowledge panel.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Passwordify',
  url: siteBase.toString(),
  logo: new URL('/favicon.svg', siteBase).href,
  sameAs: ['https://github.com/kasuken/Passwordify'],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Passwordify',
  url: siteBase.toString(),
};
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#0a0c11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Passwordify" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {pageSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Apply saved theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pwfy-theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-[var(--accent-contrast)]"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
